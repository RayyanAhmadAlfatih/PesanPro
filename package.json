    "date-fns": "^4.1.0",
    "jimp": "^1.6.0",
    "lucide-react": "^0.562.0",
    "moment": "^2.30.1",
    "moment-timezone": "^0.6.0",
    "next": "16.3.3",
    "next-auth": "5.0.0-beta.32",
    "nextjs-toploader": "^3.9.17",
    "node-cron": "^4.2.1",
    "node-webpmux": "3.2.1",
    "pino": "^10.1.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.70.0",
    "react-virtuoso": "^4.18.7",
    "recharts": "^3.7.0",
    "sharp": "0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "systeminformation": "5.33.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
