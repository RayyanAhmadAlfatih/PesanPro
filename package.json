{
  "name": "pesanpro",
  "version": "0.1.0",
  "type": "module",
  "private": false,
  "license": "MIT",
  "description": "PesanPro — WhatsApp Gateway SaaS multi-tenant.",
  "author": "PesanPro",
  "scripts": {
    "dev": "node --max-old-space-size=512 node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "build": "node --max-old-space-size=2048 node_modules/next/dist/bin/next build --webpack",
    "start": "NODE_ENV=production node --max-old-space-size=512 node_modules/tsx/dist/cli.mjs src/server/index.ts",
    "worker:messages": "tsx src/worker/index.ts",
    "worker:schedules": "tsx src/scheduler/index.ts",
    "worker:broadcasts": "tsx src/broadcast/index.ts",
    "worker:campaigns": "tsx src/campaign/index.ts",
    "worker:autoreplies": "tsx src/autoreply/index.ts",
    "worker:webhooks": "tsx src/webhook/index.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "release:preflight": "tsx scripts/release-preflight.ts",
    "test:wordpress-plugin": "php integrations/wordpress/pesanpro-contact-form-7/tests/policy-test.php",
    "lint": "eslint",
    "db:push": "prisma db push && prisma generate",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:studio": "prisma studio",
    "db:backfill-encrypt": "tsx scripts/backfill-encrypt-authstate.ts",
    "make-admin": "node scripts/setup-admin.mjs",
    "postinstall": "patch-package",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tescheck": "npm run typecheck"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
