# ==============================================================================
# 🚀 PESANPRO ENVIRONMENT CONFIGURATION TEMPLATE (Gate 0)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Generate secrets:
#   openssl rand -base64 32   # for AUTH_SECRET
#   openssl rand -hex 32       # for ENCRYPTION_KEY (64 hex chars)
# ==============================================================================

# ==============================================
# 🎯 1. REQUIRED CORE SETTINGS
# ==============================================

# Server Listening Port (e.g. 3000, 3030). Ensure this port is free!
PORT="3000"

# Database Connection URL (MySQL — PesanPro Gate 0 uses MySQL)
# Format: mysql://user:password@host:port/database
# Note: Ensure the protocol matches your schema.prisma provider setting!
DATABASE_URL="mysql://root:password@localhost:3306/pesanpro_db"

# NextAuth Encryption Secret (Generate with: openssl rand -base64 32)
# Server will exit immediately if this is not configured!
AUTH_SECRET="your-super-secret-key-at-least-32-chars-change-this-in-production"

# Encryption key for WhatsApp session credentials (AES-256-GCM)
# MUST be 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
# Server will exit if invalid. Keep this secret safe — losing it = losing all sessions.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Base URL where your application is hosted (e.g. http://localhost:3000 or https://your-domain.com)
BASE_URL="http://localhost:3000"

# Password reset email delivery (Resend). Required for password reset in production.
PASSWORD_RESET_BASE_URL="http://localhost:3000"
RESEND_API_KEY=""
PASSWORD_RESET_FROM="PesanPro <no-reply@example.com>"

# Application Environment Mode (development | production | test)
NODE_ENV="development"

# Server Hostname binding
HOSTNAME="localhost"


# ==============================================
# 🔗 2. NEXTAUTH & PROXY INTEGRATION
# ==============================================

# URL for NextAuth redirects (Should match BASE_URL)
NEXTAUTH_URL="${BASE_URL}"

# Trust Proxy Headers (Set to "true" if deployed behind Nginx, Cloudflare, or reverse proxies)
AUTH_TRUST_HOST="true"

# Public facing Next.js URLs (Derived from BASE_URL)
NEXT_PUBLIC_APP_URL="${BASE_URL}"
NEXT_PUBLIC_API_URL="${BASE_URL}/api"


# ==============================================
# 🎨 3. BRANDING & GENERAL SETTINGS
# ==============================================

# Name of the application displayed in headers and sidebar
APP_NAME="PesanPro"

# Custom Logo URL (leave empty to use default asset)
LOGO_URL=""

# Custom Favicon URL (leave empty to use default asset)
FAVICON_URL=""

# Chat list page size pagination limit (default: 50)
NEXT_PUBLIC_CHAT_PAGE_SIZE="50"

# Allow search engines to index public pages like docs/landing (true | false)
NEXT_PUBLIC_ALLOW_INDEXING="false"


# ==============================================
# 📚 4. SWAGGER API DOCUMENTATION (/docs)
# ==============================================

# Enable or disable the Swagger UI documentation route (true | false)
NEXT_PUBLIC_SWAGGER_ENABLED="true"

# Username for accessing Swagger UI basic auth credentials
NEXT_PUBLIC_SWAGGER_USERNAME="admin"

# Password for accessing Swagger UI basic auth credentials (change in production!)
NEXT_PUBLIC_SWAGGER_PASSWORD="admin123"


# ==============================================
# 🔌 5. WHATSAPP CORE (Baileys Engine)
# ==============================================

# Baileys Socket Logs Level (fatal | error | warn | info | debug | trace)
# Recommended: error for production, debug for development
BAILEYS_LOG_LEVEL="error"


# ==============================================
# 🔧 6. INTEGRATIONS & FEATURE FLAGS
# ==============================================


# Enable system notifications UI prompts (true | false)
ENABLE_NOTIFICATIONS="true"

# Enable experimental gateway features (true | false)
ENABLE_EXPERIMENTAL_FEATURES="false"


# ==============================================
# 🛡️ 7. SECURITY & LIMITS
# ==============================================

# Session token expiration duration in hours
SESSION_TIMEOUT_HOURS="24"

# Maximum media file size allowed for uploads (in Megabytes)
MAX_UPLOAD_SIZE_MB="50"

# Private media is never served from /public. Keep this path on persistent storage.
PRIVATE_MEDIA_PATH="data/private-media"
PRIVATE_MEDIA_RETENTION_DAYS="30"

# embedded: queue runs inside web; external: run npm run worker:messages; disabled: enqueue only
MESSAGE_WORKER_MODE="embedded"
# Required in external mode. Generate with: openssl rand -base64 48
MESSAGE_WORKER_SECRET=""
MESSAGE_WORKER_POLL_MS="1000"
MESSAGE_WORKER_LEASE_MS="30000"

# Durable schedule scanner. Use external with PM2, embedded for simple local use.
SCHEDULE_WORKER_MODE="embedded"
SCHEDULE_WORKER_POLL_MS="1000"
SCHEDULE_WORKER_LEASE_MS="30000"

# Durable broadcast scanner. Use external with PM2, embedded for simple local use.
BROADCAST_WORKER_MODE="embedded"
BROADCAST_WORKER_POLL_MS="1000"
BROADCAST_WORKER_LEASE_MS="30000"

# Campaign scheduler/materializer and statistics reconciler.
CAMPAIGN_WORKER_MODE="embedded"
CAMPAIGN_WORKER_POLL_MS="1000"
CAMPAIGN_WORKER_LEASE_MS="30000"

# Durable inbound auto-reply matcher and message-queue handoff.
AUTOREPLY_WORKER_MODE="embedded"
AUTOREPLY_WORKER_POLL_MS="1000"
AUTOREPLY_WORKER_LEASE_MS="30000"

# Durable webhook outbox and delivery worker. HTTPS is mandatory in production.
WEBHOOK_WORKER_MODE="embedded"
WEBHOOK_WORKER_POLL_MS="1000"
WEBHOOK_WORKER_LEASE_MS="30000"
# Development-only escape hatch for a local HTTP receiver. Never enable in production.
ALLOW_INSECURE_WEBHOOKS="false"

# Runtime observability. Readiness fails when an enabled process misses this window.
RUNTIME_HEARTBEAT_INTERVAL_MS="15000"
RUNTIME_HEARTBEAT_STALE_MS="90000"
OPS_ALERT_COOLDOWN_MS="300000"
OPS_QUEUE_WARNING_AGE_MS="300000"
OPS_QUEUE_CRITICAL_AGE_MS="1800000"
OPS_DISK_WARNING_PERCENT="80"
OPS_DISK_CRITICAL_PERCENT="90"
OPS_DATABASE_WARNING_MS="500"
OPS_DATABASE_CRITICAL_MS="2000"

# Audit and disaster recovery policy.
AUDIT_RETENTION_DAYS="365"
BACKUP_DIR="backups"
BACKUP_RETENTION_DAYS="30"
# Separate from ENCRYPTION_KEY. Required only by npm run backup:create/backup:restore.
BACKUP_ENCRYPTION_PASSPHRASE=""

# Used only for the minimum superadmin profit estimate. Set to your real monthly cost.
MONTHLY_INFRA_COST_IDR="0"

# Enable API rate limiting protection (true | false)
ENABLE_RATE_LIMITING="true"

# Maximum requests per minute allowed per IP if rate limiting is enabled
RATE_LIMIT_PER_MINUTE="60"


# ==============================================
# 🌍 8. LOCALIZATION & STORAGE
# ==============================================

# Server default timezone for scheduled campaigns (e.g., Asia/Jakarta)
TZ="Asia/Jakarta"

# Default Locale for date/time formatting on the system (e.g., id-ID, en-US)
LOCALE="id-ID"

# Media files storage folder path (relative to the project root)
MEDIA_STORAGE_PATH="uploads"


# ==============================================
# 🐳 9. DOCKER COMPOSE CONFIGURATION
# ==============================================
# These variables are required ONLY when deploying via docker-compose.yml
MYSQL_ROOT_PASSWORD="change-this-in-production"
MYSQL_DATABASE="pesanpro"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-in-production"
