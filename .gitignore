# =============================================
# Dependencies
# =============================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js / build
/.next/
/out/
/build

# Misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# Debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
server.log
/logs/

# Environment / secrets
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Runtime media
/data/media/*
!/data/media/.gitkeep

/data/private-media/*
!/data/private-media/.gitkeep

/public/media/*
!/public/media/.gitkeep

# Backups
/backups/
*.ppbackup
*.ppbackup.sha256

# Runtime database files / dumps
*.sqlite
*.sqlite3
*.db
*.sql

# IMPORTANT: Prisma SQL migrations MUST be versioned
!/prisma/migrations/**/*.sql

# Session / auth artifacts
session-*.json
creds-*.json
authstate-*

# Local agent workspace data. Never publish: it holds local notes and paths.
/.workbuddy-ai/

# Intermediate SVG from render-preview.mjs. LANDING-PREVIEW.png is the deliverable.
/landing-preview.svg

# Local build attempts and QA scratch files. These are generated, not source.
/.next.*/
/.qa-tmp/
/pure/
/brand/
/ws*.txt
/wh-raw.json
/qa-cookie-*.txt
/l13-*
/qa-pesanpro-contact-form-7.zip