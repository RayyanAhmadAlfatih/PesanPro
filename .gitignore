# =============================================
# Dependencies
# =============================================
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js / build
/.next/
/out/
/build

# Misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# Debug / logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
server.log
/logs/

# Environment / secrets
.env*
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Runtime media
/data/media/*
!/data/media/.gitkeep

/data/private-media/*
!/data/private-media/.gitkeep

/public/media/*
!/public/media/.gitkeep

# Backups
/backups/
*.ppbackup
*.ppbackup.sha256

# Runtime database files / dumps
*.sqlite
*.sqlite3
*.db
*.sql

# IMPORTANT: Prisma SQL migrations MUST be versioned
!/prisma/migrations/**/*.sql

# Session / auth artifacts
session-*.json
creds-*.json
authstate-*